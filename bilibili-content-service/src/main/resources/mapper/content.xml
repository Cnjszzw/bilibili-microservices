<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD MAPPER 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.imooc.bilibili.dao.ContentDao">

    <insert id="addContent" parameterType="com.imooc.bilibili.domain.Content"
            useGeneratedKeys="true" keyProperty="id">
        insert into
            t_content
            (
             contentDetail,
             createTime
            )values
             (
              #{contentDetail,typeHandler=com.imooc.bilibili.service.handler.JsonObjectTypeHandler},
              now()
             )
    </insert>

    <select id="getContentById" parameterType="java.lang.Long" resultType="com.imooc.bilibili.domain.Content">
        select * from t_content where id = #{id}
    </select>

</mapper>